# AI Data Analyst - Environment Variables
# Copy this file to .env and fill in your API key

# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: where projects, plots and downloads are stored (default: data, relative to backend/).
# api/main.py serves static files from data/plots and data/temp_modifications, so keep this as "data".
# DATA_DIR=data
